# ===== OBSERV AGENT · environment variables =====
# Copy into Railway → your service → Variables (or a local .env for testing).
# Railway sets PORT automatically. Do not set it yourself.

NODE_ENV=production
SITE_URL=https://observ.up.railway.app

# --- your token (shown in the CA strip, TOKEN · DEV panel, Agent Kit, AI) ---
PROJECT_NAME=OBSERV AGENT
TOKEN_TICKER=$OBSERV
# contract address, 0x + 40 hex. Empty = "PRE-LAUNCH"
TOKEN_CA=
CHAIN_NAME=Robinhood Chain
CHAIN_ID=4663
LAUNCHPAD_NAME=Pons
# full link to your token page on the launchpad, e.g. https://ponsfamily.com/launchpad/0x...
LAUNCHPAD_URL=
EXPLORER_URL=https://robinhoodchain.blockscout.com

# --- official channels + developer ---
PROJECT_X=
TELEGRAM_URL=
WEBSITE_URL=
DEV_NAME=
DEV_X=
DEV_ROLE=Founder · Builder
DEV_BIO=Building autonomous on-chain intelligence for Robinhood Chain.

# --- AI agent core (private: the provider/model never reaches the browser) ---
# Empty key (default, free) = OBSERV CORE: the on-page intent engine answers from live data, no API cost.
# Optional: a free Groq key upgrades it to a full language model.
# Free options: Groq (key gsk_…, console.groq.com) or Google Gemini (key AIza…, aistudio.google.com).
# The provider is detected from the key prefix; AI_PROVIDER / AI_MODEL / AI_BASE_URL override it.
AI_API_KEY=
AI_PROVIDER=
AI_MODEL=
# Reply language: en (default, always English) or auto (match the visitor's language)
AI_LANGUAGE=en
# 1 = show the real failure reason on the page (debug only; otherwise visitors see local mode)
AI_DEBUG_ERRORS=
AI_PER_IP_PER_MINUTE=6
AI_DAILY_LIMIT=800
AI_MAX_TOKENS=600

# --- DexPaprika ---
DEXPAPRIKA_BASE=https://api.dexpaprika.com
# optional (free key raises limits); header name per DexPaprika docs
DEXPAPRIKA_API_KEY=
DEXPAPRIKA_API_KEY_HEADER=authorization
CHAIN=robinhood
POOL_PAGES=1
REFRESH_SECONDS=60

# --- Robinhood Chain RPC (launchpad scanner, threat scanner, swap test, tx decoder) ---
# a private RPC (Alchemy / Chainstack / QuickNode) is strongly recommended: the scanners use eth_getLogs a lot
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- launchpad scanner ---
LAUNCHPAD_SCAN=1
LAUNCH_SCAN_MS=20000
LAUNCH_BACKFILL_BLOCKS=60000
# add launchpads without code (e.g. FOBO once you have its factory address):
# LAUNCHPADS_JSON=[{"key":"fobo","name":"FOBO","addrs":["0x..."]}]

# --- threat scanner ---
THREAT_CONCURRENCY=1
THREAT_MAX_BLOCKS=1500000
THREAT_CACHE_SECONDS=600
THREAT_SWAP_USD=50
HEAVY_PER_IP_PER_MINUTE=20

# --- feed tuning ---
FLOW_MIN_USD=250
LIVE_LAUNCH_MINUTES=20
STATS_SECONDS=4
DAILY_TZ_OFFSET=7
